source "https://rubygems.org"

# GitHub Pages가 서버에서 사이트를 빌드할 때 쓰는 것과
# 동일한 버전의 Jekyll + 플러그인 묶음입니다.
# 로컬 미리보기를 GitHub 결과와 일치시켜 줍니다.
gem "github-pages", group: :jekyll_plugins

# Jekyll 플러그인
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Ruby 3.x 호환을 위한 보강 gem들
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
