source "https://rubygems.org"

# The same bundle of Jekyll + plugins that GitHub Pages uses
# to build the site on its servers. Keeps local preview in sync
# with the GitHub-built result.
gem "github-pages", group: :jekyll_plugins

# Jekyll plugins
group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Extra gems for Ruby 3.x compatibility
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
